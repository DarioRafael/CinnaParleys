{
  "manifest_version": 3,
  "name": "Cinna · Playdoit",
  "version": "1.1.0",
  "description": "Manda a CinnaParleys (en tu compu) los mercados de los partidos que abres en Playdoit o Team Mexico. No pide nada por su cuenta: sólo copia lo que tu navegador ya recibió.",
  "icons": { "16": "icono16.png", "48": "icono48.png", "128": "icono128.png" },
  "action": { "default_title": "Cinna: partidos enviados", "default_icon": { "16": "icono16.png", "48": "icono48.png" } },
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["escucha.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["puente.js"]
    }
  ]
}
